# =====================================================================
# MarketLens — environment configuration
# Copy to ".env" and fill in real values. Never commit .env to git.
#
# IMPORTANT — .env file syntax:
#   • KEY=value         (value is everything after =)
#   • # full line       (comment, ignored)
#   • DO NOT put a "# comment" on the same line as a value — some parsers
#     treat the entire string after = as the value, including the #.
# =====================================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database — leave SQLite for dev, switch to PostgreSQL for production.
# Examples:
#   sqlite:///./marketlens.db
#   postgresql+psycopg2://marketlens:secret@localhost:5432/marketlens
DATABASE_URL=sqlite:///./marketlens.db

# Redis — optional. Without it, app falls back to in-memory cache (single-worker only).
# Example: redis://localhost:6379/0
REDIS_URL=

# Celery — optional background job queue. Without these, jobs run synchronously.
# Example: redis://localhost:6379/1 for both
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ML — directory where trained model artifacts are persisted
ML_MODELS_DIR=./ml_models
ML_MIN_TRAINING_SAMPLES=500

# TimescaleDB hypertables — set false to skip the hypertable creation attempt
CREATE_HYPERTABLES=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# =====================================================================
# --- Angel One SmartAPI ---
# Register an app at https://smartapi.angelbroking.com/
# ALL FOUR values below are REQUIRED for live mode. SmartAPI rejects login
# with "Invalid password parameter name" if MPIN is blank.
# =====================================================================
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
# 4-digit MPIN (NOT your angelone.in website login password).
# Reset in Angel One mobile app -> Profile -> Change MPIN if forgotten.
ANGELONE_PASSWORD=
# Base32 secret from Angel One mobile app -> Profile -> Security -> Enable TOTP.
# Shown ONCE during setup. If lost, disable+re-enable TOTP for a new one.
ANGELONE_TOTP_SECRET=

# =====================================================================
# LIVE_ONLY mode
# When TRUE: backend REFUSES to serve synthetic/paper data.
#   • Any market-data endpoint returns 503 if broker isn't authenticated
#   • Background thread re-attempts login every 5 minutes on failure
#   • Visit /api/broker/diagnose for step-by-step root cause when login fails
# Set to TRUE when you want real-trade-ready signals only.
# =====================================================================
LIVE_ONLY=true

# =====================================================================
# --- Astrology defaults (NSE = Mumbai) ---
# =====================================================================
ASTRO_LATITUDE=19.0760
ASTRO_LONGITUDE=72.8777
ASTRO_TIMEZONE=Asia/Kolkata
ASTRO_AYANAMSA=LAHIRI

# =====================================================================
# --- Risk management defaults ---
# =====================================================================
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_MAX_POSITION_PCT=5.0
RISK_DEFAULT_RR=2.0

# =====================================================================
# --- Background scanner universe ---
# Which symbol pool the picks_scanner sweeps every 5 minutes:
#   fno_top50  → ~50 most-liquid F&O names (fastest, narrowest)
#   fno        → ~180 F&O universe
#   nifty500   → ~500 Nifty 500 + F&O (DEFAULT — best breadth vs speed)
#   all_nse    → ~2000 NSE equities (broadest, slowest, max coverage)
#
# Prefilter auto-enables above 250 symbols so scan time stays bounded.
# Force on/off with SCANNER_PREFILTER=1 / =0; leave unset for auto.
# =====================================================================
SCANNER_UNIVERSE=nifty500
SCANNER_PREFILTER=

# =====================================================================
# --- Alerts (Telegram) ---
# 1. Talk to @BotFather on Telegram -> /newbot -> get TOKEN
# 2. Talk to @userinfobot to get your CHAT_ID
# 3. Send any message to your bot first (Telegram requires it)
# =====================================================================
ALERTS_ENABLED=false
ALERTS_MIN_CONFIDENCE=75
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =====================================================================
# --- Frontend ---
# Leave blank for same-origin /api proxy (works on any host)
# =====================================================================
NEXT_PUBLIC_API_BASE=
